# VivIrpinia Agent — Variabili d'ambiente
# Copia questo file in .env e compila i valori
# NON committare .env su GitHub — usa i GitHub Secrets

# ── WordPress ─────────────────────────────────────────────────
WP_URL=https://www.vivirpinia.it
WP_USER=admin
# Application Password: WP Admin → Utenti → Il tuo profilo → Application Passwords
# Formato: xxxx xxxx xxxx xxxx xxxx xxxx (con spazi)
WP_APP_PASSWORD=

# ── Facebook (opzionale) ──────────────────────────────────────
# Token da: https://developers.facebook.com/tools/explorer/
# Scade ogni 60 giorni — rinnova e aggiorna il secret su GitHub
FB_TOKEN=

# ── Impostazioni ──────────────────────────────────────────────
HTTP_TIMEOUT=20
REQUEST_DELAY=2
